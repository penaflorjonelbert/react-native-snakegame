<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Classic Snake Game</title>
    <style>
        body {
            background-color: #1a1a1a;
            color: #ffffff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            overflow: hidden;
        }

        h1 {
            margin-bottom: 10px;
            font-size: 2.5rem;
            letter-spacing: 2px;
        }

        #score-board {
            font-size: 1.2rem;
            margin-bottom: 20px;
            background: #2a2a2a;
            padding: 10px 20px;
            border-radius: 5px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        }

        #score {
            font-weight: bold;
            color: #4CAF50;
        }

        canvas {
            background-color: #111;
            border: 4px solid #333;
            border-radius: 8px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        }

        .controls-hint {
            margin-top: 15px;
            font-size: 0.9rem;
            color: #888;
        }
    </style>
</head>
<body>

    <h1>SNAKE</h1>
    <div id="score-board">Score: <span id="score">0</span></div>
    <canvas id="gameCanvas" width="400" height="400"></canvas>
    <div class="controls-hint">Use <b>Arrow Keys</b> to Move | Press <b>Spacebar</b> to Restart</div>

    <script>
        const canvas = document.getElementById("gameCanvas");
        const ctx = canvas.getContext("2d");
        const scoreElement = document.getElementById("score");

        const gridSize = 20; 
        const tileCount = canvas.width / gridSize;

        // Game speed (lower = faster)
        const gameSpeed = 100; 

        let snake = [];
        let food = { x: 0, y: 0 };
        let dx = gridSize; // horizontal velocity
        let dy = 0;        // vertical velocity
        let score = 0;
        let gameInterval;
        let changingDirection = false;

        // Start the game
        initGame();

        function initGame() {
            // Initial Snake setup (3 blocks long in center)
            snake = [
                { x: gridSize * 5, y: gridSize * 5 },
                { x: gridSize * 4, y: gridSize * 5 },
                { x: gridSize * 3, y: gridSize * 5 }
            ];
            score = 0;
            dx = gridSize;
            dy = 0;
            scoreElement.innerText = score;
            createFood();
            clearInterval(gameInterval);
            gameInterval = setInterval(mainLoop, gameSpeed);
        }

        // Main game loop
        function mainLoop() {
            if (hasGameEnded()) {
                clearInterval(gameInterval);
                drawGameOver();
                return;
            }

            changingDirection = false;
            clearCanvas();
            drawFood();
            moveSnake();
            drawSnake();
        }

        // Clear the canvas each frame
        function clearCanvas() {
            ctx.fillStyle = "#111";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }

        // Draw the snake onto the canvas
        function drawSnake() {
            snake.forEach((part, index) => {
                // Head is brighter green, body is regular green
                ctx.fillStyle = index === 0 ? '#4CAF50' : '#388E3C';
                ctx.strokeStyle = '#111';
                
                ctx.fillRect(part.x, part.y, gridSize, gridSize);
                ctx.strokeRect(part.x, part.y, gridSize, gridSize);
            });
        }

        // Advance snake coordinates
        function moveSnake() {
            const head = { x: snake[0].x + dx, y: snake[0].y + dy };
            snake.unshift(head);

            // Check if snake ate the food
            const hasEatenFood = snake[0].x === food.x && snake[0].y === food.y;
            if (hasEatenFood) {
                score += 10;
                scoreElement.innerText = score;
                createFood();
            } else {
                // Remove the last part of snake if it didn't eat food
                snake.pop();
            }
        }

        // Generate random coordinates for food
        function createFood() {
            food.x = Math.floor(Math.random() * tileCount) * gridSize;
            food.y = Math.floor(Math.random() * tileCount) * gridSize;

            // Ensure food doesn't spawn inside the snake's body
            snake.forEach(part => {
                const hasEaten = part.x === food.x && part.y === food.y;
                if (hasEaten) createFood();
            });
        }

        // Draw food on canvas
        function drawFood() {
            ctx.fillStyle = '#FF5252';
            ctx.fillRect(food.x, food.y, gridSize, gridSize
